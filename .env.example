# Base de datos y servicios
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/saas_procesos
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
JWT_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-segura
# Opcional pero recomendado: clave estable para cifrar SMTP/WhatsApp guardados desde Admin.
# Si se omite, se deriva de JWT_SECRET_KEY; no la rotes mientras existan secretos cifrados.
INTEGRATION_CREDENTIALS_KEY=

# Credenciales iniciales del usuario administrador
ADMIN_EMAIL=admin@sistema.local
ADMIN_PASSWORD=admin123

# Valores iniciales/fallback; después se pueden mantener desde Admin > Operación.
# WhatsApp API (UltraMsg.com)
WHATSAPP_API_URL=api_ultramsg
WHATSAPP_TOKEN=token_ultramsg

# Cloudflare R2 (API compatible con S3). No usar estas variables en el frontend.
# Crea una API token con permisos de lectura/escritura solo sobre el bucket de pruebas.
R2_ACCOUNT_ID=TU_ACCOUNT_ID
R2_ACCESS_KEY_ID=TU_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=TU_SECRET_ACCESS_KEY
R2_BUCKET_NAME=TU_BUCKET
# Opcional; por defecto se construye con R2_ACCOUNT_ID.
# R2_ENDPOINT_URL=https://tu_account_id.r2.cloudflarestorage.com

# Valores iniciales/fallback; después se pueden mantener desde Admin > Operación.
# Servicio de Correos
# SMTP
# SMTP Submission con STARTTLS (puerto 587).
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_FROM=notificaciones@tudominio.com
SMTP_USER=notificaciones@tudominio.com
SMTP_PASSWORD=TU_CONTRASENA_SMTP
SMTP_STARTTLS=true

# Vercel Workflows para consultas judiciales.
# Configura el mismo secreto en los servicios frontend y backend de Vercel.
WORKFLOW_SERVICE_TOKEN=
# Secreto para autenticar las invocaciones de Vercel Cron en el servicio frontend.
CRON_SECRET=
# Solo para next dev local; en Vercel BACKEND_SERVICE_URL lo genera el service binding.
WORKFLOW_BACKEND_URL=http://localhost:8000
