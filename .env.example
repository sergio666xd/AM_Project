# Base de datos y servicios
DATABASE_URL=postgresql://dev_user:dev_password@localhost:5432/saas_procesos
# Generate this VAPID pair once and keep it stable; the private key is secret.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=mailto:contacto@alejandramunozabogada.com
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Origins para los enlaces enviados en correos y WhatsApp. Si se omiten,
# producción usa los subdominios admin/panel; en desarrollo se usa FRONTEND_URL local.
# ADMIN_PORTAL_URL=https://admin.alejandramunozabogada.com
# USER_PORTAL_URL=https://panel.alejandramunozabogada.com
JWT_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-y-segura
# Opcional pero recomendado: clave estable para cifrar SMTP/WhatsApp guardados desde Admin.
# Si se omite, se deriva de JWT_SECRET_KEY; no la rotes mientras existan secretos cifrados.
INTEGRATION_CREDENTIALS_KEY=

# Credenciales iniciales del usuario administrador
ADMIN_EMAIL=admin@sistema.local
ADMIN_PASSWORD=admin123

# WhatsApp Cloud API de Meta (ver docs/whatsapp-cloud-api.md). Con WHATSAPP_TOKEN y
# WHATSAPP_PHONE_NUMBER_ID todo WhatsApp sale por Meta con plantillas aprobadas.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WABA_ID=
# Cadena aleatoria que inventas y escribes igual en Meta al configurar el webhook.
WHATSAPP_VERIFY_TOKEN=
# Clave secreta de la app de Meta; valida la firma de cada llamada al webhook.
WHATSAPP_APP_SECRET=
# WHATSAPP_GRAPH_VERSION=v23.0
# WHATSAPP_IDIOMA_PLANTILLAS=es
# Proveedor anterior (solo si faltan las variables de Meta): URL del proveedor.
# WHATSAPP_API_URL=

# Cloudflare R2 (API compatible con S3). No usar estas variables en el frontend.
# La API token debe poder listar, leer, escribir y borrar objetos en ambos buckets.
# El bucket del sistema guarda documentos de expedientes y demás archivos de la plataforma.
# R2_BUCKET_NAME se conserva como compatibilidad/fallback durante la separación inicial.
R2_ACCOUNT_ID=TU_ACCOUNT_ID
R2_ACCESS_KEY_ID=TU_ACCESS_KEY_ID
R2_SECRET_ACCESS_KEY=TU_SECRET_ACCESS_KEY
R2_SYSTEM_BUCKET_NAME=sistema-am
# Bucket exclusivo para tarjetas profesionales y archivos de registro de abogados.
R2_TP_REGISTROS_BUCKET_NAME=tp-registros
# Fallback histórico si aún no se configuran los dos buckets separados.
R2_BUCKET_NAME=tp-registros
# Opcional; por defecto se construye con R2_ACCOUNT_ID.
# R2_ENDPOINT_URL=https://tu_account_id.r2.cloudflarestorage.com

# Valores iniciales/fallback; después se pueden mantener desde Admin > Operación.
# Servicio de Correos
# SMTP
# SMTP Submission con STARTTLS (puerto 587).
SMTP_HOST=smtp.tudominio.com
SMTP_PORT=587
SMTP_FROM=notificaciones@tudominio.com
SMTP_USER=notificaciones@tudominio.com
SMTP_PASSWORD=TU_CONTRASENA_SMTP
SMTP_STARTTLS=true

# Vercel Workflows para consultas judiciales.
# Configura el mismo secreto en los servicios frontend y backend de Vercel.
WORKFLOW_SERVICE_TOKEN=
# Secreto para autenticar las invocaciones de Vercel Cron en el servicio frontend.
CRON_SECRET=
# Solo para next dev local; en Vercel BACKEND_SERVICE_URL lo genera el service binding.
WORKFLOW_BACKEND_URL=http://localhost:8000
# Backend al que next dev reenvía /api (mismo origen para la cookie de sesión).
BACKEND_DEV_URL=http://127.0.0.1:8000
