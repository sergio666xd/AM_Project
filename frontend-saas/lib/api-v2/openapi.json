  "components": {
    "schemas": {
      "ErrorRespuesta": {
        "properties": {
          "codigo": {
            "type": "string",
            "title": "Codigo",
            "description": "Identificador estable del error, para decidir qué mostrar."
          },
          "mensaje": {
            "type": "string",
            "title": "Mensaje",
            "description": "Texto listo para mostrar al usuario."
          },
          "campos": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Campos",
            "description": "Errores por campo del formulario, con el nombre del campo como clave."
          }
        },
        "type": "object",
        "required": [
          "codigo",
          "mensaje"
        ],
        "title": "ErrorRespuesta"
      },
      "IniciarSesion": {
        "properties": {
          "email": {
            "type": "string",
            "maxLength": 120,
            "minLength": 3,
            "title": "Email"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          },
          "recordarme": {
            "type": "boolean",
            "title": "Recordarme",
            "description": "Mantiene la sesión abierta 15 días en este dispositivo.",
            "default": true
          }
        },
        "type": "object",
        "required": [
          "email",
          "password"
        ],
        "title": "IniciarSesion"
      },
      "PaginaProcesos": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProcesoResumen"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total",
            "description": "Cantidad total con los filtros aplicados, sin contar el cursor."
          },
          "siguiente": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Siguiente",
            "description": "Cursor de la página siguiente, o null si no hay más."
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "siguiente"
        ],
        "title": "PaginaProcesos"
      },
      "PersonaBreve": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "nombre": {
            "type": "string",
            "title": "Nombre"
