    "/api/v2/procesos": {
      "get": {
        "tags": [
          "Procesos"
        ],
        "summary": "Listar procesos",
        "description": "Procesos que el usuario puede ver, del más reciente al más antiguo.",
        "operationId": "listar_procesos",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 2,
                  "maxLength": 100
                },
                {
                  "type": "null"
                }
              ],
              "description": "Busca en el nombre del proceso, el radicado (con o sin guiones) y el nombre del cliente.",
              "title": "Q"
            },
            "description": "Busca en el nombre del proceso, el radicado (con o sin guiones) y el nombre del cliente."
          },
          {
            "name": "archivados",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Lista los archivados en lugar de los activos.",
              "default": false,
              "title": "Archivados"
            },
            "description": "Lista los archivados en lugar de los activos."
          },
          {
            "name": "limite",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Elementos por página.",
              "default": 25,
              "title": "Limite"
            },
            "description": "Elementos por página."
          },
          {
            "name": "cursor",
            "in": "query",
            "required": false,
            "schema": {
