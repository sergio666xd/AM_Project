{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "frontend": {
        "root": "frontend-saas/",
        "framework": "nextjs"
      },
      "backend": {
        "root": "./",
        "entrypoint": "app.main:app",
        "framework": "fastapi"
      }
    },
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/docs",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/openapi.json",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "frontend"
        }
      }
    ]
  }