{
    "$schema": "https://openapi.vercel.sh/vercel.json",
    "services": {
      "frontend": {
        "root": "frontend-saas/",
        "framework": "nextjs",
        "bindings": [
          {
            "type": "service",
            "service": "backend",
            "format": "url",
            "env": "BACKEND_SERVICE_URL"
          }
        ]
      },
      "backend": {
        "root": "./",
        "entrypoint": "app.main:app",
        "framework": "fastapi"
      }
    },
    "crons": [
      {
        "path": "/cron/consultas/12",
        "schedule": "0 17 * * *"
      },
      {
        "path": "/cron/consultas/17",
        "schedule": "0 22 * * *"
      },
      {
        "path": "/cron/resumen-mensual",
        "schedule": "0 22 * * *"
      }
    ],
    "rewrites": [
      {
        "source": "/api/(.*)",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/docs",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/openapi.json",
        "destination": {
          "service": "backend"
        }
      },
      {
        "source": "/(.*)",
        "destination": {
          "service": "frontend"
        }
      }
    ]
  }